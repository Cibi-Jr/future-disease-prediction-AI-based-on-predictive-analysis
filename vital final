  .auth-left{display:none;}
  .sidebar{width:60px;min-width:60px;}
  .sidebar .brand-n,.sidebar .nav-item span:not(.nav-icon),.sidebar .user-info,.sidebar .logout-btn,.sb-section{display:none;}
  .inner-page{padding:20px 16px;}
  .g2c,.g3c,.g4c{grid-template-columns:1fr;}
}
