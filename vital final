<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Vital — Health Intelligence OS</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#F7F8FA;--surface:#FFFFFF;--card:#FFFFFF;--border:#EAECF0;--border2:#D0D5DD;
  --text:#0A0D14;--text2:#344054;--muted:#667085;
  --blue:#0052CC;--blue-l:#1570EF;--blue-bg:#EBF5FF;--blue-mid:#DBEAFE;
  --teal:#027A48;--teal-bg:#ECFDF3;--teal-l:#12B76A;
  --amber:#B54708;--amber-bg:#FFFAEB;--amber-l:#F79009;
  --red:#B42318;--red-bg:#FEF3F2;--red-l:#F04438;
  --violet:#5925DC;--violet-bg:#F4F3FF;
  --cyan:#0E7090;--cyan-bg:#ECFEFF;
  --font-head:'Syne',sans-serif;--font-body:'DM Sans',sans-serif;--font-mono:'DM Mono',monospace;
  --r:16px;--r-sm:10px;
  --shadow:0 1px 3px rgba(16,24,40,.06),0 4px 16px rgba(16,24,40,.08);
  --shadow-lg:0 8px 32px rgba(16,24,40,.14);
  --glow-blue:0 0 24px rgba(0,82,204,.3);
  --sidebar-w:240px;
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;height:100%;overflow:hidden;-webkit-font-smoothing:antialiased;}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);font-size:14px;line-height:1.5;}
button{cursor:pointer;font-family:var(--font-body);}
input,select,textarea{font-family:var(--font-body);}

.page{display:none;width:100%;height:100vh;overflow:hidden;}
.page.active{display:flex;}
@keyframes up{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
@keyframes scanLine{0%{transform:translateY(-100%)}100%{transform:translateY(400%)}}
@keyframes rotate3d{0%{transform:rotateY(0deg)}100%{transform:rotateY(360deg)}}
@keyframes glow{0%,100%{filter:drop-shadow(0 0 4px rgba(0,150,255,.4))}50%{filter:drop-shadow(0 0 12px rgba(0,150,255,.9))}}
@keyframes dataFlow{0%{stroke-dashoffset:100}100%{stroke-dashoffset:0}}
@keyframes heartbeat{0%,100%{transform:scale(1)}14%{transform:scale(1.15)}28%{transform:scale(1)}}

/* ─── AUTH ─── */
.auth-wrap{display:grid;grid-template-columns:1fr 480px;width:100%;height:100vh;}
.auth-left{
  background:#020912;
  display:flex;flex-direction:column;justify-content:space-between;padding:52px 56px;
  position:relative;overflow:hidden;
}
.auth-bg-grid{position:absolute;inset:0;background-image:
  linear-gradient(rgba(0,82,204,.08) 1px,transparent 1px),
  linear-gradient(90deg,rgba(0,82,204,.08) 1px,transparent 1px);
  background-size:40px 40px;pointer-events:none;}
.auth-glow-1{position:absolute;top:-120px;left:-120px;width:500px;height:500px;background:radial-gradient(circle,rgba(0,82,204,.18),transparent 70%);pointer-events:none;}
.auth-glow-2{position:absolute;bottom:-100px;right:-80px;width:400px;height:400px;background:radial-gradient(circle,rgba(0,150,255,.12),transparent 70%);pointer-events:none;}

.auth-brand-lg{display:flex;align-items:center;gap:14px;z-index:2;position:relative;}
.auth-logo-mark{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#0052CC,#0096FF);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(0,82,204,.4);}
.auth-logo-mark svg{width:22px;height:22px;stroke:#fff;stroke-width:2.5;fill:none;}
.auth-brand-lg .brand-name{font-family:var(--font-head);font-size:26px;font-weight:800;color:#fff;letter-spacing:-.5px;}
.auth-brand-lg .brand-tag{font-size:11px;color:rgba(255,255,255,.35);letter-spacing:2px;text-transform:uppercase;}

.auth-hero{z-index:2;position:relative;flex:1;display:flex;flex-direction:column;justify-content:center;padding:40px 0;}
.auth-hero h1{font-family:var(--font-head);font-size:58px;font-weight:800;line-height:1.05;color:#fff;letter-spacing:-1.5px;margin-bottom:20px;}
.auth-hero h1 .hl{color:#0096FF;}
.auth-hero p{font-size:15px;color:rgba(255,255,255,.45);line-height:1.8;max-width:400px;}

/* 3D Body preview in auth */
.auth-body-preview{position:absolute;right:40px;top:50%;transform:translateY(-50%);opacity:.15;pointer-events:none;}

.auth-stat-strip{display:flex;gap:0;z-index:2;position:relative;border:1px solid rgba(255,255,255,.08);border-radius:14px;overflow:hidden;background:rgba(255,255,255,.03);backdrop-filter:blur(8px);}
.astat{flex:1;padding:20px;border-right:1px solid rgba(255,255,255,.06);}
.astat:last-child{border:none;}
.astat .n{font-family:var(--font-head);font-size:30px;font-weight:700;color:#0096FF;}
.astat .l{font-size:10px;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:1px;margin-top:3px;}

.auth-right{background:#fff;display:flex;align-items:center;justify-content:center;padding:40px;overflow-y:auto;border-left:1px solid #eee;}
.auth-form-wrap{width:100%;max-width:380px;}
.auth-step{display:none;}
.auth-step.active{display:block;animation:up .3s cubic-bezier(.22,1,.36,1);}
.step-indicator{display:flex;gap:4px;margin-bottom:24px;}
.step-dot{height:3px;flex:1;border-radius:2px;background:var(--border2);transition:background .3s;}
.step-dot.done{background:var(--blue);}

.auth-eyebrow{font-size:11px;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px;}
.auth-title{font-family:var(--font-head);font-size:28px;font-weight:800;letter-spacing:-.5px;margin-bottom:4px;}
.auth-sub{font-size:13px;color:var(--muted);margin-bottom:28px;line-height:1.6;}

.fg{margin-bottom:14px;}
.fg label{display:block;font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.7px;margin-bottom:6px;}
.fg input,.fg select,.fg textarea{width:100%;background:#FAFAFA;border:1.5px solid var(--border2);border-radius:var(--r-sm);padding:11px 14px;color:var(--text);font-size:13.5px;outline:none;transition:all .2s;}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(0,82,204,.08);}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.btn-main-auth{width:100%;padding:13px;border:none;border-radius:var(--r-sm);background:var(--blue);color:#fff;font-size:14px;font-weight:700;font-family:var(--font-head);letter-spacing:.3px;transition:all .2s;margin-top:4px;}
.btn-main-auth:hover{background:var(--blue-l);transform:translateY(-1px);box-shadow:0 8px 24px rgba(0,82,204,.3);}
.auth-link{text-align:center;margin-top:16px;font-size:12.5px;color:var(--muted);}
.auth-link a{color:var(--blue);cursor:pointer;font-weight:600;text-decoration:none;}
.bmi-preview{background:var(--blue-bg);border:1.5px solid rgba(0,82,204,.15);border-radius:var(--r-sm);padding:12px;margin-bottom:14px;display:none;}
.bmi-val-big{font-family:var(--font-head);font-size:32px;font-weight:700;color:var(--blue);}

/* ─── APP SHELL ─── */
.app-shell{display:flex;width:100%;height:100vh;overflow:hidden;}
.sidebar{
  width:var(--sidebar-w);min-width:var(--sidebar-w);
  background:#020912;height:100vh;display:flex;flex-direction:column;
  z-index:100;flex-shrink:0;border-right:1px solid rgba(255,255,255,.06);
  position:relative;overflow:hidden;
}
.sb-bg-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(0,82,204,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,82,204,.05) 1px,transparent 1px);background-size:32px 32px;pointer-events:none;}
.sb-top{padding:22px 16px 12px;position:relative;z-index:2;}
.sb-brand{display:flex;align-items:center;gap:10px;margin-bottom:28px;}
.sb-mark{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#0052CC,#0096FF);display:flex;align-items:center;justify-content:center;box-shadow:0 2px 12px rgba(0,82,204,.4);}
.sb-mark svg{width:15px;height:15px;stroke:#fff;stroke-width:2.5;fill:none;}
.sb-brand .brand-n{font-family:var(--font-head);font-size:18px;font-weight:800;color:#fff;letter-spacing:-.3px;}

.sb-section{font-size:9px;font-weight:700;color:rgba(255,255,255,.2);text-transform:uppercase;letter-spacing:2px;padding:12px 12px 6px;position:relative;z-index:2;}
.sb-nav{display:flex;flex-direction:column;gap:1px;padding:0 8px;position:relative;z-index:2;}
.nav-item{display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:9px;cursor:pointer;color:rgba(255,255,255,.35);font-size:12.5px;font-weight:500;transition:all .15s;white-space:nowrap;}
.nav-item:hover{color:rgba(255,255,255,.8);background:rgba(255,255,255,.06);}
.nav-item.active{color:#fff;background:linear-gradient(135deg,rgba(0,82,204,.5),rgba(0,150,255,.3));box-shadow:0 2px 12px rgba(0,82,204,.2);}
.nav-icon{font-size:14px;width:18px;text-align:center;flex-shrink:0;}
.nav-badge{margin-left:auto;background:var(--red-l);color:#fff;border-radius:10px;padding:1px 7px;font-size:9px;font-weight:700;}

.sb-bottom{margin-top:auto;padding:12px 16px;border-top:1px solid rgba(255,255,255,.06);position:relative;z-index:2;}
.user-pill{display:flex;align-items:center;gap:10px;padding:10px;background:rgba(255,255,255,.05);border-radius:10px;margin-bottom:8px;cursor:pointer;}
.user-av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#0052CC,#0096FF);display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700;flex-shrink:0;}
.user-info .uname{font-size:13px;font-weight:600;color:#fff;}
.user-info .urole{font-size:10px;color:#0096FF;font-weight:600;}
.logout-btn{width:100%;padding:8px;border:1px solid rgba(255,255,255,.1);background:transparent;color:rgba(255,255,255,.4);border-radius:8px;font-size:12px;font-weight:500;transition:all .2s;}
.logout-btn:hover{border-color:rgba(244,67,54,.5);color:#F44336;background:rgba(244,67,54,.1);}

.main{flex:1;height:100vh;overflow-y:auto;overflow-x:hidden;background:var(--bg);}
.inner-page{display:none;min-height:100vh;padding:28px 32px 80px;}
.inner-page.active{display:block;animation:up .25s cubic-bezier(.22,1,.36,1);}

.ph{margin-bottom:24px;display:flex;align-items:flex-start;justify-content:space-between;}
.ph-left h1{font-family:var(--font-head);font-size:28px;font-weight:800;letter-spacing:-.5px;}
.ph-left p{font-size:13px;color:var(--muted);margin-top:3px;}
.ph-actions{display:flex;gap:8px;align-items:center;}

/* GRIDS */
.g2c{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.g3c{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;}
.g4c{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}

/* CARDS */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:20px;box-shadow:var(--shadow);}
.card-dark{background:#020912;border:1px solid rgba(255,255,255,.08);border-radius:var(--r);padding:20px;position:relative;overflow:hidden;}

/* METRIC PILLS */
.mpill{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:16px 18px;box-shadow:var(--shadow);transition:all .2s;cursor:pointer;}
.mpill:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg);}
.mpill .icon{font-size:20px;margin-bottom:8px;}
.mpill .val{font-family:var(--font-head);font-size:26px;font-weight:700;}
.mpill .lbl{font-size:10.5px;color:var(--muted);margin-top:2px;font-weight:500;text-transform:uppercase;letter-spacing:.5px;}
.mpill .chg{font-size:11.5px;margin-top:6px;font-weight:600;}
.chg-g{color:var(--teal-l);}
.chg-r{color:var(--red-l);}
.chg-w{color:var(--amber-l);}

/* BADGE */
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:50px;font-size:11px;font-weight:600;}
.bg{background:var(--teal-bg);color:var(--teal);}
.bw{background:var(--amber-bg);color:var(--amber);}
.br{background:var(--red-bg);color:var(--red);}
.bb{background:var(--blue-bg);color:var(--blue);}
.bv{background:var(--violet-bg);color:var(--violet);}
.bc{background:var(--cyan-bg);color:var(--cyan);}

/* PROGRESS */
.pbar{background:var(--border);border-radius:50px;height:5px;overflow:hidden;margin-top:6px;}
.pfill{height:100%;border-radius:50px;transition:width 1.2s ease;}

/* SECTION HEAD */
.sh{font-family:var(--font-head);font-size:16px;font-weight:700;margin-bottom:14px;letter-spacing:-.2px;}

/* BUTTONS */
.btn{padding:9px 18px;border:none;border-radius:9px;font-size:13px;font-weight:600;transition:all .18s;cursor:pointer;font-family:var(--font-body);}
.btn-blue{background:var(--blue);color:#fff;}
.btn-blue:hover{background:var(--blue-l);}
.btn-ghost{background:transparent;border:1.5px solid var(--border2);color:var(--text2);}
.btn-ghost:hover{border-color:var(--blue);color:var(--blue);}
.btn-sm{padding:6px 13px;font-size:12px;border-radius:8px;}
.btn-dark{background:var(--text);color:#fff;}
.btn-dark:hover{background:#1d2939;}

.sep{border-top:1px solid var(--border);margin:18px 0 16px;}

/* TOGGLE */
.t-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);}
.t-row:last-child{border-bottom:none;}
.t-lbl{font-size:13.5px;font-weight:500;}
.t-desc{font-size:11.5px;color:var(--muted);margin-top:1px;}
.toggle{position:relative;width:40px;height:22px;flex-shrink:0;}
.toggle input{opacity:0;width:0;height:0;}
.tslider{position:absolute;cursor:pointer;inset:0;background:#CBD5E0;border-radius:50px;transition:.25s;}
.tslider:before{content:'';position:absolute;height:16px;width:16px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.25s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
.toggle input:checked+.tslider{background:var(--blue);}
.toggle input:checked+.tslider:before{transform:translateX(18px);}

/* BARS CHART */
.cbars{display:flex;align-items:flex-end;gap:7px;padding:0 2px;}
.cbar-w{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;}
.cbar{width:100%;border-radius:5px 5px 0 0;min-height:3px;transition:height .9s ease;}
.cbar-l{font-size:10px;color:var(--muted);}
.cbar-v{font-family:var(--font-head);font-size:11px;font-weight:600;color:var(--text2);}

/* SCORE RING */
.score-ring{position:relative;width:130px;height:130px;margin:0 auto 10px;}
.score-ring svg{transform:rotate(-90deg);}
.score-inner{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.score-num{font-family:var(--font-head);font-size:38px;font-weight:800;}
.score-lbl{font-size:10px;color:var(--muted);font-weight:500;letter-spacing:.5px;text-transform:uppercase;}

/* DONUT */
.donut-wrap{position:relative;width:120px;height:120px;flex-shrink:0;}
.donut-wrap svg{transform:rotate(-90deg);}
.donut-inner{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;}

/* TABLE */
.tbl{width:100%;border-collapse:collapse;}
.tbl th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);font-weight:600;padding:9px 12px;border-bottom:1px solid var(--border);}
.tbl td{padding:11px 12px;font-size:13px;border-bottom:1px solid var(--border);color:var(--text2);}
.tbl tr:last-child td{border-bottom:none;}
.tbl tr:hover td{background:var(--bg);}

/* NOTIFICATION */
.notif{position:fixed;top:20px;right:20px;padding:14px 18px;border-radius:14px;font-size:13px;font-weight:500;transform:translateY(-80px);opacity:0;transition:all .4s cubic-bezier(.22,1,.36,1);z-index:9999;box-shadow:var(--shadow-lg);max-width:320px;display:flex;align-items:center;gap:10px;}
.notif.show{transform:translateY(0);opacity:1;}
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(60px);background:var(--text);color:#fff;padding:11px 22px;border-radius:50px;font-weight:500;font-size:13px;opacity:0;transition:all .3s;z-index:9998;box-shadow:var(--shadow-lg);pointer-events:none;}
#toast.show{transform:translateX(-50%) translateY(0);opacity:1;}

/* ─── 3D BODY TECHNICAL ─── */
.body3d-wrap{position:relative;display:flex;align-items:center;justify-content:center;padding:20px 0;}
.body3d-svg{filter:drop-shadow(0 0 12px rgba(0,150,255,.4));animation:glow 2.5s ease-in-out infinite;}
.body3d-scan{position:absolute;inset:0;overflow:hidden;pointer-events:none;border-radius:8px;}
.scan-beam{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(0,150,255,.8),transparent);animation:scanLine 3s linear infinite;}
.body3d-rings{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;}
.body3d-hud{position:absolute;font-size:9px;color:#0096FF;font-family:var(--font-mono);font-weight:500;letter-spacing:.5px;opacity:.7;}

/* CHAT */
.chat-shell{display:flex;flex-direction:column;height:calc(100vh - 160px);}
.chat-messages{flex:1;overflow-y:auto;padding:4px 0 20px;display:flex;flex-direction:column;gap:12px;}
.msg{display:flex;gap:8px;max-width:85%;}
.msg.user{align-self:flex-end;flex-direction:row-reverse;}
.msg-av{width:26px;height:26px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;}
.msg-av.ai{background:var(--blue);color:#fff;}
.msg-av.user{background:var(--text);color:#fff;}
.msg-bubble{padding:11px 14px;border-radius:12px;font-size:13px;line-height:1.65;}
.msg.ai .msg-bubble{background:var(--surface);border:1px solid var(--border);border-radius:3px 12px 12px 12px;}
.msg.user .msg-bubble{background:var(--text);color:#fff;border-radius:12px 3px 12px 12px;}
.typing-dot{width:5px;height:5px;border-radius:50%;background:var(--muted);animation:pulse 1.2s ease infinite;display:inline-block;margin:0 2px;}
.typing-dot:nth-child(2){animation-delay:.2s;}
.typing-dot:nth-child(3){animation-delay:.4s;}
.chat-input-area{border-top:1px solid var(--border);padding-top:14px;}
.chat-input-row{display:flex;gap:8px;align-items:flex-end;}
.chat-input-row textarea{flex:1;background:var(--bg);border:1.5px solid var(--border2);border-radius:10px;padding:10px 13px;font-size:13px;resize:none;outline:none;color:var(--text);transition:border-color .2s;max-height:100px;}
.chat-input-row textarea:focus{border-color:var(--blue);}
.chat-send{padding:10px 18px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-weight:600;font-size:13px;transition:all .18s;white-space:nowrap;}
.chat-send:hover{background:var(--blue-l);}
.upload-row{display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap;}
.upload-btn{display:flex;align-items:center;gap:6px;padding:7px 13px;border:1.5px dashed var(--border2);border-radius:9px;background:transparent;color:var(--muted);font-size:12px;font-weight:500;transition:all .2s;}
.upload-btn:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-bg);}
.upload-preview{display:none;position:relative;}
.upload-preview img{height:44px;width:60px;object-fit:cover;border-radius:7px;border:1px solid var(--border);}
.upload-remove{position:absolute;top:-5px;right:-5px;width:15px;height:15px;background:var(--text);color:#fff;border-radius:50%;border:none;font-size:9px;display:flex;align-items:center;justify-content:center;cursor:pointer;}

/* WATER */
.water-entry{display:flex;align-items:center;justify-content:space-between;padding:9px 13px;background:var(--blue-bg);border-radius:9px;}
.water-entry .wtime{font-size:11px;color:var(--blue);font-weight:600;}
.water-entry .wamt{font-family:var(--font-head);font-size:15px;font-weight:700;color:var(--blue);}

/* LIFESTYLE PRED */
.pred-card{border-radius:var(--r);padding:24px;position:relative;overflow:hidden;}
.pred-bad{background:linear-gradient(135deg,#1A0505 0%,#3D0A0A 100%);}
.pred-good{background:linear-gradient(135deg,#020E07 0%,#052A12 100%);}
.pred-card h3{font-family:var(--font-head);font-size:22px;color:#fff;margin-bottom:8px;font-weight:800;}
.pred-card p{font-size:13px;color:rgba(255,255,255,.6);line-height:1.75;}

/* WATCH */
.watch-connect{border:2px dashed var(--border2);border-radius:var(--r);padding:32px;text-align:center;cursor:pointer;transition:all .2s;}
.watch-connect:hover{border-color:var(--blue);background:var(--blue-bg);}
.watch-connected{background:#020912;border-radius:var(--r);padding:22px;border:1px solid rgba(0,150,255,.2);}
.wm{background:rgba(255,255,255,.06);border-radius:10px;padding:14px;text-align:center;border:1px solid rgba(0,150,255,.1);}
.wm .wmval{font-family:var(--font-head);font-size:22px;font-weight:700;color:#0096FF;}
.wm .wmlbl{font-size:10px;color:rgba(255,255,255,.4);margin-top:2px;text-transform:uppercase;letter-spacing:.5px;}

/* DISEASE */
.drow{display:flex;align-items:center;justify-content:space-between;padding:13px 0;border-bottom:1px solid var(--border);cursor:pointer;transition:all .15s;}
.drow:last-child{border-bottom:none;}
.drow:hover{background:var(--bg);margin:0 -20px;padding:13px 20px;border-radius:9px;}
.dname{font-size:13.5px;font-weight:500;}
.dtrigger{font-size:11px;color:var(--muted);margin-top:2px;}
.dpct{font-family:var(--font-head);font-size:20px;font-weight:700;}

.disease-hero{border-radius:var(--r);padding:28px;margin-bottom:14px;background:#020912;border:1px solid rgba(0,150,255,.15);}
.disease-risk-bar{height:6px;border-radius:3px;margin-top:10px;background:rgba(255,255,255,.1);overflow:hidden;}
.disease-risk-fill{height:100%;border-radius:3px;transition:width 1s ease;}

.detail-back{display:flex;align-items:center;gap:7px;margin-bottom:20px;cursor:pointer;color:var(--muted);font-size:13px;font-weight:500;width:fit-content;padding:6px 12px;border:1px solid var(--border);border-radius:8px;transition:all .2s;}
.detail-back:hover{color:var(--text);border-color:var(--blue);}

/* MONTHLY CHART */
.monthly-chart-wrap{padding:10px 0;}
.chart-svg{overflow:visible;}

/* HOSTEL */
.hostel-meal{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px;}
.hostel-meal-name{font-weight:600;font-size:13.5px;margin-bottom:8px;}
.macro-chip{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:3px 10px;font-size:11px;font-weight:500;}

/* NUTRITION SCAN RESULT */
.scan-nutrient-table{width:100%;border-collapse:collapse;margin-top:8px;}
.scan-nutrient-table th{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);padding:7px 10px;border-bottom:2px solid var(--border);text-align:left;font-weight:600;}
.scan-nutrient-table td{padding:9px 10px;font-size:12.5px;border-bottom:1px solid var(--border);color:var(--text2);}
.scan-nutrient-table tr:last-child td{border-bottom:none;font-weight:700;color:var(--text);background:var(--bg);}

/* FULL CONTENT */
.full-content{padding-bottom:60px;}

/* PROFILE */
.profile-body-card{text-align:center;padding:24px 16px;}
.body-gen-toggle{display:flex;background:var(--bg);border:1px solid var(--border2);border-radius:8px;overflow:hidden;width:fit-content;margin:0 auto 16px;}
.gen-btn{padding:6px 16px;border:none;background:transparent;font-size:11.5px;font-weight:600;color:var(--muted);cursor:pointer;transition:all .2s;font-family:var(--font-body);}
.gen-btn.active{background:var(--blue);color:#fff;}

/* MONTHLY SCORE */
.month-bar{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1;}
.month-bar .mb-fill{width:28px;border-radius:5px 5px 0 0;transition:height .9s ease;cursor:pointer;}
.month-bar .mb-fill:hover{opacity:.8;}
.month-bar .mb-lbl{font-size:10px;color:var(--muted);}
.month-bar .mb-val{font-size:11px;font-weight:600;color:var(--text2);}

/* QA TILE */
.qa-tile{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:20px;cursor:pointer;transition:all .2s;box-shadow:var(--shadow);}
.qa-tile:hover{border-color:var(--blue);transform:translateY(-2px);box-shadow:var(--shadow-lg);}

/* PREDICTION */
.future-metric{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.fm-label{font-size:12.5px;font-weight:500;}
.fm-vals{font-size:12px;color:var(--muted);}

@media(max-width:960px){
